@page "/admins/{id:guid}"
@attribute [Authorize(Roles = "admin")]
@inject NavigationManager NavigationManager
@inject IAdminClient AdminClient
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResources> Localizer
@using mSzczepienia.Shared.DTO.Accounts
@using mSzczepienia.Shared.Enums
@using mSzczepienia.Client.Shared.Components
@using mSzczepienia.Client.Shared.Components.Skeletons

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">@Localizer["AdminDetails"]</MudText>

    @if (_isLoading)
    {
        <AdvancedAccountDetailsSeleton />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <ErrorState Message="@_errorMessage" OnRetry="LoadAdminData" />
    }
    else if (_admin != null)
    {
        <MudCard Elevation="3" Class="pa-4">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Secondary" Size="Size.Large">
                        @_admin.Name.FirstOrDefault()@_admin.Surname.FirstOrDefault()
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">@_admin.Name @_admin.Surname</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["AdministratorAccount"]</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text" Icon="@Icons.Material.Filled.Security">
                        @_admin.Role.ToString()
                    </MudChip>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <MudDivider Class="mb-4" />
                <MudGrid>
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Primary">@Localizer["BasicInfo"]</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_admin.Name" Label="@Localizer["First Name"]" ReadOnly="true" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_admin.Surname" Label="@Localizer["Surname"]" ReadOnly="true" Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_admin.Email" Label="@Localizer["Email"]" ReadOnly="true" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_admin.DateOfBirth.ToShortDateString()" Label="@Localizer["DateOfBirth"]" ReadOnly="true" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Cake" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Primary">@Localizer["SystemInfo"]</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_admin.CreationDate.ToString("g")" Label="@Localizer["AccountCreationDate"]" ReadOnly="true" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_admin.Id.ToString()" Label="@Localizer["GUID"]" ReadOnly="true" Variant="Variant.Outlined"/>
                    </MudItem>

                </MudGrid>
            </MudCardContent>

            <MudCardActions Class="pa-4 justify-space-between">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
                    @Localizer["BackToSearch"]
                </MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAdmin">
                    @Localizer["EditDetails"]
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private DetailedAccountDto? _admin;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAdminData();
    }

    private async Task LoadAdminData()
    {
        _isLoading = true;
        _errorMessage = null;
        await Task.Delay(2000);
        try
        {
            _admin = await AdminClient.GetAdminByIdAsync(Id, CancellationToken.None);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _errorMessage = Localizer["AdminNotFound"];
        }
        catch (Exception ex)
        {
            _errorMessage = Localizer["ErrorLoadingAdmin"];
            Snackbar.Add($"{_errorMessage}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void EditAdmin()
    {
        NavigationManager.NavigateTo($"/admins/{Id}/edit");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/staff?SelectedRole={(int)Role.Admin}");
    }
}