@page "/vaccines"
@attribute [Authorize(Roles = "admin")]
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer
@inject IVaccineClient VaccineClient
@inject ISnackbar Snackbar
@using mSzczepienia.Shared.DTO
@using mSzczepienia.Shared.DTO.Vaccines

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">
    <MudGrid Spacing="4">

        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Width="100%">
                <MudText Typo="Typo.h6" Color="Color.Primary" Align="Align.Center" Class="mb-4">
                    @Localizer["Filters"]
                </MudText>
                <MudDivider Class="mb-4" />

                <MudStack Spacing="3">
                    <MudAutocomplete T="string" @bind-Value="Name" Label="@Localizer["Name"]" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Placeholder="@Localizer["EnterName"]" SearchFunc="@GetNamesAsync" ResetValueOnEmptyText="true"
                                     CoerceText="false" DebounceInterval="500" AdornmentIcon="@Icons.Material.Filled.Search" MinCharacters="3"/>
                    <MudAutocomplete T="string" @bind-Value="Manufacturer" Label="@Localizer["Manufacturer"]" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Placeholder="@Localizer["EnterManufacturer"]" SearchFunc="@GetManufacturersAsync"
                                     ResetValueOnEmptyText="true" CoerceText="false" DebounceInterval="500" AdornmentIcon="@Icons.Material.Filled.Search"
                                     MinCharacters="3"/>
                    <MudTextField @bind-Value="Disease" Label="@Localizer["TargetDisease"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Placeholder="@Localizer["EnterTargetDisease"]" InputType="InputType.Search" />
                    <MudTextField @bind-Value="Id" Label="@Localizer["ID"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@Localizer["EnterID"]" InputType="InputType.Number" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="ApplyFilters" Class="mt-2">
                        @Localizer["Apply"]
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" Class="mb-6">
                @Localizer["Vaccines"]
            </MudText>

            @if (isLoading)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4" ContentAlignment="HorizontalAlignment.Center">
                    <MudStack AlignItems="AlignItems.Center">
                        <MudText>@errorMessage</MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Surface"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="OnRetryClick"
                                   Style="color: var(--mud-palette-error);">
                            @Localizer["TryAgain"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            }
            else if (vaccines.Items == null || !vaccines.Items.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                    @Localizer["NoVaccinesFound"]
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="4">
                    @foreach (var vaccine in vaccines.Items)
                    {
                        <MudPaper Elevation="4" Class="pa-4 hover-elevation transition-ease" Style="border-left: 5px solid var(--mud-palette-primary);">
                            <MudGrid Class="align-center">
                                <MudItem xs="12" sm="8">
                                    <MudText Typo="Typo.h6"><b>@vaccine.VaccineName</b></MudText>
                                    <MudStack Row="true" Spacing="1" Class="mt-1">
                                        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            @foreach (var disease in GetLocalizedDiseases(vaccine))
                                            {
                                                @disease@if (disease != GetLocalizedDiseases(vaccine).Last()) { <text>, </text> }
                                            }
                                        </MudText>
                                    </MudStack>
                                    <MudStack Row="true" Spacing="1" Class="mt-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Factory"Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@vaccine.Manufacturer</MudText>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               EndIcon="@Icons.Material.Filled.ArrowForward"
                                               OnClick="@(() => OpenDetails(vaccine.VaccineId))">
                                        @Localizer["Details"]
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>

                <div class="d-flex flex-column align-center mt-8">
                    <MudPagination Color="Color.Primary" Count="@vaccines.TotalPages" Selected="@Page" SelectedChanged="OnPageChanged" />
                </div>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .hover-elevation:hover {
        box-shadow: 0px 4px 20px rgba(0,0,0,0.12);
        transform: translateY(-2px);
    }

    .transition-ease {
        transition: all 0.3s ease;
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "Manufacturer")]
    public string? Manufacturer { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Name")]
    public string? Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Disease")]
    public string? Disease { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Id")]
    public int? Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Page")]
    public int Page { get; set; } = 1;

    public int PageSize { get; set; } = 6;

    private PagedResult<VaccineDto> vaccines = new();
    private bool isLoading = false;
    private string? errorMessage = null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
        await base.OnParametersSetAsync();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        if (Page < 1)
            Page = 1;

        try
        {
            vaccines = await VaccineClient.GetVaccinesAsync(Name, Manufacturer, Disease, Id, Page, PageSize, new CancellationToken());
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = Localizer["ErrorLoadingVaccines"];
            Snackbar.Add($"{errorMessage}: ({httpEx.StatusCode},{httpEx.Message})", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }

        if (Page > vaccines.TotalPages && vaccines.TotalPages > 0)
        {
            Page = vaccines.TotalPages;
        }
    }

    private async Task OnRetryClick()
    {
        await LoadData();
    }

    private void ApplyFilters()
    {
        Page = 1;
        UpdateUrl();
    }

    private IEnumerable<string> GetLocalizedDiseases(VaccineDto vaccine)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        return culture == "pl" ? vaccine.DiseasesPl : vaccine.DiseasesEn;
    }

    private async Task<IEnumerable<string>> GetManufacturersAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return new List<string>();
        return await VaccineClient.GetManufacturersAutocompleteAsync(value, token);
    }

    private async Task<IEnumerable<string>> GetNamesAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return new List<string>();
        return await VaccineClient.GetNamesAutocompleteAsync(value, token);
    }

    private void OnPageChanged(int page)
    {
        if (page == Page) return;
        Page = page;
        UpdateUrl();
    }

    private void OpenDetails(int id)
    {
        NavigationManager.NavigateTo($"/vaccines/{id}");
    }

    private void UpdateUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("Manufacturer");
        query.Remove("Name");
        query.Remove("Disease");
        query.Remove("Id");
        query.Remove("Page");

        query.Add("Page", Page.ToString());

        if (!string.IsNullOrWhiteSpace(Manufacturer))
            query["Manufacturer"] = Manufacturer;
        if (!string.IsNullOrWhiteSpace(Name))
            query["Name"] = Name;
        if (!string.IsNullOrWhiteSpace(Disease))
            query["Disease"] = Disease;
        if (Id.HasValue)
            query["Id"] = Id.ToString();
        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        NavigationManager.NavigateTo(newUri, forceLoad: false);
    }
}
