@page "/citizens/search"
@attribute [Authorize(Roles = "worker")]
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer
@inject ICitizenClient CitizenClient
@inject ISnackbar Snackbar
@using mSzczepienia.Shared.DTO
@using mSzczepienia.Shared.DTO.Citizens
@using mSzczepienia.Shared.DTO.Queries
@using mSzczepienia.Client.Shared.Components.Skeletons
@using System.Text.RegularExpressions

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">
    <MudGrid Spacing="4">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Width="100%">
                <MudText Typo="Typo.h6" Color="Color.Primary" Align="Align.Center" Class="mb-4">
                    @Localizer["Filters"]
                </MudText>
                <MudDivider Class="mb-4" />

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="Name" Label="@Localizer["First Name"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Placeholder="@Localizer["EnterFirstName"]" InputType="InputType.Search" />
                    <MudTextField @bind-Value="Surname" Label="@Localizer["Surname"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@Localizer["EnterSurname"]" InputType="InputType.Search" />
                    <MudTextField @bind-Value="Pesel" Label="@Localizer["PESEL"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@Localizer["EnterPESEL"]" InputType="InputType.Number" />
                    <MudCheckBox T="bool?" Value="@WorkersFacility" Label="@Localizer["SearchAssignedToYourFacility"]"
                                 ValueChanged="@(val => OnWorkersFacilityChanged(val))" Color="Color.Primary" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="ApplyFilters" Class="mt-2">
                        @Localizer["Apply"]
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" Class="mb-6"> @Localizer["Citizens"] </MudText>

            @if (_isLoading)
            {
                <ListSkeleton Count="PageSize" PaperHeight="116px" Line1Width="30%" Line2Width="35%"/>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Message="@_errorMessage" OnRetry="@(() => LoadCitizens())" />
            }
            else if (citizens?.Items != null && citizens.TotalCount > 0)
            {
                <MudStack Spacing="3">
                    @foreach (var cit in citizens.Items)
                    {
                        var statusMeta = GetStatusMetadata(cit.SubmissionStatus);

                        <MudPaper Elevation="1" Class="pa-4 transition-item">
                            <MudGrid Class="align-center">
                                <MudItem xs="12" sm="8">
                                    <MudText Typo="Typo.subtitle1"><b>@cit.Name @cit.Surname</b></MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @Localizer["DateOfBirth"]: @cit.DateOfBirth.ToShortDateString()
                                    </MudText>

                                    <MudStack Row="true" Spacing="2" Class="mt-1">
                                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Badge" Variant="Variant.Text" Color="Color.Primary">@Localizer["PESEL"]: @cit.Pesel</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@statusMeta.Color"
                                                 Icon="@statusMeta.Icon">@Localizer["SubmissionState"]: @FormatEnum(cit.SubmissionStatus)</MudChip>
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12" sm="4" Class="d-flex justify-end">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenCitizenDetails(cit.Id))">
                                        @Localizer["Details"]
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>

                @if (citizens.TotalPages > 1)
                {
                    <div class="d-flex justify-center mt-6">
                        <MudPagination Color="Color.Primary" Count="@citizens.TotalPages" Selected="@Page" SelectedChanged="OnPageChanged" />
                    </div>
                }
            }
            else
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center mud-background-gray">
                    <MudIcon Icon="@Icons.Material.TwoTone.PersonSearch" Size="Size.Large" Style="font-size: 4rem;" Color="Color.Default" Class="mb-4 opacity-50" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Align="Align.Center">@Localizer["NoCitizensToShow"]</MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .transition-item {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        will-change: transform, box-shadow;
    }

        .transition-item:hover {
            transform: translateY(-4px);
            box-shadow: 0px 8px 24px rgba(0,0,0,0.12) !important;
        }

    .opacity-50 {
        opacity: 0.5;
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "WorkersFacility")]
    public bool? WorkersFacility { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Pesel")]
    public string? Pesel { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Surname")]
    public string? Surname { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Name")]
    public string? Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Page")]
    public int Page { get; set; } = 1;

    public int PageSize { get; set; } = 10;

    private PagedResult<SimpleCitizenDto>? citizens;
    private bool _isLoading = true;
    private string? _errorMessage = null;


    protected override async Task OnParametersSetAsync()
    {
        if (WorkersFacility == null)
        {
            WorkersFacility = true;
        }

        var t1 = LoadCitizens();
        var t2 = base.OnParametersSetAsync();
        await Task.WhenAll(t1, t2);
    }

    private async Task LoadCitizens()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        if (Page < 1)
            Page = 1;

        try
        {
            var query = new GetCitizensQuery
            {
                PageNumber = Page,
                PageSize = PageSize,
                SearchInWorkersFacilityOnly = WorkersFacility.HasValue ? (bool)WorkersFacility : true,
                Name = Name,
                Surname = Surname,
                Pesel = Pesel
            };
            citizens = await CitizenClient.GetCitizensAsync(query, new CancellationToken());
        }
        catch (HttpRequestException httpEx)
        {
            _errorMessage = Localizer["ErrorLoadingCitizens"];
            Snackbar.Add($"{_errorMessage}: ({httpEx.StatusCode},{httpEx.Message})", Severity.Error);
        }
        catch (Exception ex)
        {
            _errorMessage = Localizer["ErrorLoadingCitizens"];
            Snackbar.Add($"{_errorMessage}: ({ex.Message})", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        if (Page > citizens?.TotalPages && citizens.TotalPages > 0)
        {
            Page = citizens.TotalPages;
            UpdateUrl();
        }
    }

    private void ApplyFilters()
    {
        Page = 1;
        UpdateUrl();
    }

    private void OnPageChanged(int page)
    {
        if (page == Page) return;
        Page = page;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("Name");
        query.Remove("Surname");
        query.Remove("Pesel");
        query.Remove("WorkersFacility");
        query.Remove("Page");

        query.Add("Page", Page.ToString());

        if (!string.IsNullOrWhiteSpace(Name))
            query["Name"] = Name;
        if (!string.IsNullOrWhiteSpace(Surname))
            query["Surname"] = Surname;
        if (!string.IsNullOrWhiteSpace(Pesel))
            query["Pesel"] = Pesel;
        if (WorkersFacility.HasValue)
        {
            query["WorkersFacility"] = WorkersFacility.Value.ToString();
        }

        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        NavigationManager.NavigateTo(newUri, forceLoad: false);
    }

    private void OnWorkersFacilityChanged(bool? value)
    {
        WorkersFacility = value;
    }

    private string FormatEnum(string en)
    {
        return Regex.Replace(en, "(\\B[A-Z])", " $1");
    }

    private (Color Color, string Icon) GetStatusMetadata(string status)
    {
        return status switch
        {
            "Accepted" => (Color.Success, Icons.Material.Filled.CheckCircle),
            "Rejected" => (Color.Error, Icons.Material.Filled.Cancel),
            "Pending" => (Color.Warning, Icons.Material.Filled.HourglassEmpty),
            "NotUploaded" => (Color.Default, Icons.Material.Filled.EditNote),
            _ => (Color.Info, Icons.Material.Filled.Help)
        };
    }

    private void OpenCitizenDetails(int citizenId)
    {
        NavigationManager.NavigateTo($"/citizens/{citizenId}");
    }
}
