@page "/facilities"
@attribute [Authorize(Roles = "admin")]
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer
@inject IFacilityClient FacilityClient
@inject ISnackbar Snackbar
@using mSzczepienia.Shared.DTO
@using mSzczepienia.Shared.DTO.Facilities

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">
    <MudGrid Spacing="4">

        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4" Width="100%">
                <MudText Typo="Typo.h6" Color="Color.Primary" Align="Align.Center" Class="mb-4">
                    @Localizer["Filters"]
                </MudText>
                <MudDivider Class="mb-4" />

                <MudStack Spacing="3">
                    <MudAutocomplete T="string" @bind-Value="City" Label="@Localizer["City"]" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Placeholder="@Localizer["EnterCity"]" ResetValueOnEmptyText="true" SearchFunc="@GetCitiesAsync"
                                     CoerceText="false" DebounceInterval="500" AdornmentIcon="@Icons.Material.Filled.Search" />
                    <MudTextField @bind-Value="Street" Label="@Localizer["Street"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@Localizer["EnterStreet"]" />
                    <MudTextField @bind-Value="PostalCode" Label="@Localizer["PostalCode"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Placeholder="@Localizer["EnterPostalCode"]" Mask="@(new PatternMask("00-000"))" />
                    <MudTextField @bind-Value="Id" Label="@Localizer["ID"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="@Localizer["EnterID"]" InputType="InputType.Number" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="ApplyFilters" Class="mt-2">
                        @Localizer["Apply"]
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" Class="mb-6">
                @Localizer["MedicalFacilities"]
            </MudText>

            @if (isLoading)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4" ContentAlignment="HorizontalAlignment.Center">
                    <MudStack AlignItems="AlignItems.Center">
                        <MudText>@errorMessage</MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Surface"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="OnRetryClick"
                                   Style="color: var(--mud-palette-error);">
                            @Localizer["TryAgain"]
                        </MudButton>
                    </MudStack>
                </MudAlert>
            }
            else if (facilities.Items == null || !facilities.Items.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                    @Localizer["NoFacilitiesFound"]
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="4">
                    @foreach (var facility in facilities.Items)
                    {
                        <MudPaper Elevation="4" Class="pa-4 transition-item" Style="border-left: 5px solid var(--mud-palette-primary);">
                            <MudGrid Class="align-center">
                                <MudItem xs="12" sm="8">
                                    <MudText Typo="Typo.h6"><b>@facility.Name</b></MudText>
                                    <MudStack Row="true" Spacing="1" Class="mt-1">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            @facility.Street, @facility.PostalCode @facility.City
                                        </MudText>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               EndIcon="@Icons.Material.Filled.ArrowForward"
                                               OnClick="@(() => OpenDetails(facility.Id))">
                                        @Localizer["Details"]
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>

                <div class="d-flex flex-column align-center mt-8">
                    <MudPagination Color="Color.Primary" Count="@facilities.TotalPages" Selected="@Page" SelectedChanged="OnPageChanged" />
                </div>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .transition-item {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        will-change: transform, box-shadow;
    }

        .transition-item:hover {
            transform: translateY(-4px);
            box-shadow: 0px 8px 24px rgba(0,0,0,0.12) !important;
        }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "City")]
    public string? City { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Street")]
    public string? Street { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "PostalCode")]
    public string? PostalCode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Id")]
    public int? Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Page")]
    public int Page { get; set; } = 1;

    public int PageSize { get; set; } = 6;

    private PagedResult<SearchFacilityDto> facilities = new();
    private bool isLoading = false;
    private string? errorMessage = null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
        await base.OnParametersSetAsync();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        if (Page < 1)
            Page = 1;

        try
        {
            facilities = await FacilityClient.GetFacilitiesAsync(City, Street, PostalCode, Id, Page, PageSize, new CancellationToken());
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = Localizer["ErrorLoadingFacilities"];
            Snackbar.Add($"{errorMessage}: ({httpEx.StatusCode},{httpEx.Message})", Severity.Error);
        }
        catch (Exception ex)
        {
            errorMessage = Localizer["ErrorLoadingFacilities"];
            Snackbar.Add($"{errorMessage}: ({ex.Message})", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

        if (Page > facilities.TotalPages && facilities.TotalPages > 0)
        {
            Page = facilities.TotalPages;
            UpdateUrl();
        }
    }

    private async Task OnRetryClick()
    {
        await LoadData();
    }

    private async Task<IEnumerable<string>> GetCitiesAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || value.Length < 2)
            return new List<string>();
        return await FacilityClient.GetCitiesAutocompleteAsync(value, token);
    }

    private void ApplyFilters()
    {
        Page = 1;
        UpdateUrl();
    }

    private void OnPageChanged(int page)
    {
        if (page == Page) return;
        Page = page;
        UpdateUrl();
    }

    private void OpenDetails(int id)
    {
        NavigationManager.NavigateTo($"/facilities/{id}");
    }

    private void UpdateUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        query.Remove("City");
        query.Remove("Street");
        query.Remove("PostalCode");
        query.Remove("Id");
        query.Remove("Page");

        query.Add("Page", Page.ToString());

        if (!string.IsNullOrWhiteSpace(City))
            query["City"] = City;
        if (!string.IsNullOrWhiteSpace(Street))
            query["Street"] = Street;
        if (!string.IsNullOrWhiteSpace(PostalCode))
            query["PostalCode"] = PostalCode;
        if (Id.HasValue)
            query["Id"] = Id.ToString();
        var newUri = $"{uri.GetLeftPart(UriPartial.Path)}?{query}";
        NavigationManager.NavigateTo(newUri, forceLoad: false);
    }
}
