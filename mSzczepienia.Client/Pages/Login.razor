@page "/login"
@layout EmptyLayout
@inject IStringLocalizer<SharedResources> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject ILocalStorageService LocalStorage
@inject HttpClient Http
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@using System.Globalization
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@using System.Text


<div class="center-container">
    <MudPaper Class="mud-theme-primary pa-8" Height="600px" Width="400px" Elevation="4">
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="4">
            <div style="text-align:center">
                <h3 class="mud-theme-primary-text mud-typography-h3 mud-text-center mud-pa-6" style="margin:auto;">@Localizer["appName"]</h3>
            </div>
            <div style="text-align:center">
                <h4 class="mud-theme-secondary-text mud-typography-h4 mud-text-center mud-pa-6" style="margin:auto;">@Localizer["logIn"]</h4>
            </div>
            <MudTextField @bind-Value="userEmail" Label="@Localizer["Email"]" HelperText="@Localizer["EnterEmail"]"
                          Required="true" Variant="@Variant.Filled" FullWidth="true" Clearable="true" ShrinkLabel="true"/>
            <MudTextField @bind-Value="userPassword" Label="@Localizer["Password"]" InputType="InputType.Password" HelperText="@Localizer["EnterPassword"]"
                          Required="true" Variant="Variant.Filled" FullWidth="true" Clearable="true" ShrinkLabel="true" />
            <MudButton OnClick="onLoginClicked" Variant="Variant.Filled" Color="Color.Success" style="width:200px">
                @if (isProcessing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit"/>}
                else {@Localizer["logInButton"]}
            </MudButton>
            <a class="mud-theme-secondary-text mud-typography-body2 mud-text-center mud-pa-6" style="margin:auto;">@Localizer["forgotPassword"]</a>
        </MudStack>
    </MudPaper>
</div>

@code {
    string userEmail = string.Empty;
    string userPassword = string.Empty;
    bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var role = user.FindFirst("role")?.Value;

            if (role == "admin")
                NavManager.NavigateTo("/admin-dashboard", replace: true);
            else if (role == "worker")
                NavManager.NavigateTo("/worker-dashboard", replace: true);
            else
                NavManager.NavigateTo("/", replace: true);

            return;
        }
    }

    public async Task onLoginClicked()
    {
        isProcessing = true;

        try
        {
            var authUrl = $"{Configuration["Firebase:AuthDomain"]}{Configuration["Firebase:ApiKey"]}";
            var payload = new { email = userEmail, password = userPassword, returnSecureToken = true };

            var response = await Http.PostAsJsonAsync(authUrl, payload);

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadFromJsonAsync<FirebaseResponse>();

                await LocalStorage.SetItemAsStringAsync("authToken", content.idToken);

                if (AuthStateProvider is CustomAuthStateProvider customProvider)
                    customProvider.NotifyUserAuthentication(content.idToken);

                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var role = authState.User.FindFirst("role")?.Value;
                if (role == "admin")
                    NavManager.NavigateTo("/admin-dashboard", forceLoad: true);
                else if (role == "worker")
                    NavManager.NavigateTo("/worker-dashboard", forceLoad: true);
                else
                    NavManager.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                Snackbar.Add(Localizer["loginFailed"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Localizer["loginErrorOccurred"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}
