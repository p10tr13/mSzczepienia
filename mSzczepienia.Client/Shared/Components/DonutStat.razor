@inject IStringLocalizer<SharedResources> Localizer

<MudGrid Class="align-center justify-center">
    <MudItem xs="12" sm="6" Class="d-flex flex-column align-center justify-center">
        <MudChart ChartType="ChartType.Donut" Width="@ChartSize" Height="@ChartSize" InputData="_chartData" InputLabels="Labels" ChartOptions="Options" />
        @if (_isEmpty)
        {
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mud-text-secondary pt-4">
                @Localizer["NoDataToShow"]
            </MudText>
        }
    </MudItem>

    <MudItem xs="12" sm="6" Class="d-flex flex-column align-center justify-center">
        <MudText Typo="Typo.h2" Color="Color.Primary">
            <b>@MainValue</b>
        </MudText>
        <MudText Typo="Typo.h6" Class="mud-text-secondary">
            @MainLabel
        </MudText>
    </MudItem>
</MudGrid>

@if (ShowLegend && !_isEmpty)
{
    <div class="d-flex justify-center mt-4 gap-4 flex-wrap">
        <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Circle" Style="color: #00c853; font-size: 1rem;" Class="mr-1" /> <MudText Typo="Typo.caption">@Localizer["Reviewed"]</MudText></div>
        <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Circle" Style="color: #2979ff; font-size: 1rem;" Class="mr-1" /> <MudText Typo="Typo.caption">@Localizer["NotReviewed"]</MudText></div>
        <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Circle" Style="color: #ff1744; font-size: 1rem;" Class="mr-1" /> <MudText Typo="Typo.caption">@Localizer["Rejected"]</MudText></div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public double[] Data { get; set; } = Array.Empty<double>();

    [Parameter, EditorRequired]
    public int MainValue { get; set; }

    [Parameter, EditorRequired]
    public string MainLabel { get; set; } = string.Empty;

    [Parameter]
    public string ChartSize { get; set; } = "160px";

    [Parameter]
    public bool ShowLegend { get; set; } = true;

    private string[] Labels = Array.Empty<string>();

    private ChartOptions Options { get; set; }

    private double[] _chartData = Array.Empty<double>();
    private bool _isEmpty = false;

    protected override void OnParametersSet()
    {
        Labels = new string[]
        {
            Localizer["Reviewed"],
            Localizer["NotReviewed"],
            Localizer["Rejected"]
        };

        if (Data == null || Data.Length == 0 || Data.Sum() == 0)
        {
            _isEmpty = true;
            _chartData = new double[] { 1 };
            Options = new ChartOptions
            {
                ChartPalette = new[] { "#e0e0e0" },
                ShowLegend = false
            };
        }
        else
        {
            _isEmpty = false;
            _chartData = Data;
            Options = new ChartOptions
            {
                ChartPalette = new[] { "#00c853", "#2979ff", "#ff1744" },
                ShowLegend = false
            };
        }
    }
}

