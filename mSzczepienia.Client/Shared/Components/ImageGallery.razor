@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResources> Localizer

<MudPaper Elevation="2" Class="relative overflow-hidden d-flex justify-center align-center"
          Style="@($"height: {Height}; width: 100%; background-color: var(--mud-palette-background-grey);")">

    @if (Images == null || !Images.Any())
    {
        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Color="Color.Secondary" />
    }
    else
    {
        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Variant="Variant.Filled" Color="Color.Surface" Size="Size.Small" OnClick="ResetView"
                       Class="absolute z-10" Style="top: 16px; right: 16px; opacity: 0.9;" />

        <div class="absolute z-10" style="left: 16px; top: 50%; transform: translateY(-50%);">
            <MudTooltip Text="@Localizer["PreviousPage"]">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIosNew" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_currentIndex == 0)" OnClick="PreviousImage"
                               Style="opacity: 0.8;" />
            </MudTooltip>
        </div>

        <div class="absolute z-10" style="right: 16px; top: 50%; transform: translateY(-50%);">
            <MudTooltip Text="@Localizer["NextPage"]">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowForwardIos" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_currentIndex >= Images.Count - 1)"
                               OnClick="NextImage" Style="opacity: 0.8;" />
            </MudTooltip>
        </div>

        <div class="absolute z-10" style="bottom: 16px; left: 50%; transform: translateX(-50%); pointer-events: none;">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Dark" Style="opacity: 0.7;">
                @(_currentIndex + 1) / @Images.Count
            </MudChip>
        </div>

        <Panzoom @ref="_panzoom" WheelMode="WheelMode.ZoomWithWheel" PanzoomOptions="@_panzoomOptions">

            <div @ref="@context.ElementReference" class="d-flex justify-center align-center" style="width: 100%; height: 100%;">
                <img src="@CurrentUrl" draggable="false" style="width: 100%; height: 100%; object-fit: contain; pointer-events: none;" alt="Document" />
            </div>
        </Panzoom>
    }
</MudPaper>

<style>
    .z-10 {
        z-index: 10;
    }

    .absolute {
        position: absolute !important;
    }

    .relative {
        position: relative !important;
    }
</style>

@code {
    [Parameter]
    public List<string> Images { get; set; } = new();

    [Parameter]
    public string Height { get; set; } = "600px";

    private Panzoom _panzoom;
    private int _currentIndex = 0;

    private string CurrentUrl => (Images != null && Images.Count > 0) ? Images[_currentIndex] : string.Empty;

    private PanzoomOptions _panzoomOptions = new PanzoomOptions
    {
        MinScale = 0.5,
        MaxScale = 6.0,
        Canvas = true,
        Contain = Contain.Outside
    };

    protected override void OnParametersSet()
    {
        if (Images != null && _currentIndex >= Images.Count)
        {
            _currentIndex = 0;
        }
    }

    private async Task NextImage()
    {
        if (Images != null && _currentIndex < Images.Count - 1)
        {
            _currentIndex++;
            await ResetZoomInternal();
        }
    }

    private async Task PreviousImage()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
            await ResetZoomInternal();
        }
    }

    private async Task ResetView()
    {
        await ResetZoomInternal();
    }

    private async Task ResetZoomInternal()
    {
        if (_panzoom != null) await _panzoom.ResetAsync();
    }
}