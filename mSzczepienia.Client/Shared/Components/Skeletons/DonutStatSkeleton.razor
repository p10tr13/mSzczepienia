@inject IStringLocalizer<SharedResources> Localizer

<MudGrid Class="align-center justify-center">
    <!-- Donut chart placeholder -->
    <MudItem xs="12" sm="6" Class="d-flex justify-center">
        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="160px" Height="160px" />
    </MudItem>

    <!-- Stats -->
    <MudItem xs="12" sm="6" Class="d-flex flex-column align-center justify-center">
        <MudSkeleton Width="40%" Height="200px" />
        <MudText Typo="Typo.h6" Class="mud-text-secondary">@Localizer["BookletsToVerify"]</MudText>
    </MudItem>
</MudGrid>

<!-- Legend -->
<div class="d-flex justify-center mt-4 gap-4 flex-wrap">
    <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Circle" Style="color: #2979ff; font-size: 0.8rem;" Class="mr-1" /> <MudText Typo="Typo.caption">@Localizer["NotReviewed"]</MudText></div>
    <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Circle" Style="color: #00e676; font-size: 0.8rem;" Class="mr-1" /> <MudText Typo="Typo.caption">@Localizer["Accepted"]</MudText></div>
    <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Circle" Style="color: #ff1744; font-size: 0.8rem;" Class="mr-1" /> <MudText Typo="Typo.caption">@Localizer["Rejected"]</MudText></div>
</div>
